{% extends "base.html.j2" %}
{% set pair = page.pair %}
{% block title %}{{ _("Folder pair") }} — {{ pair.removed_from }}{% endblock %}
{% block content %}
<p class="muted"><a href="../report.html">← {{ _("Back to the report") }}</a></p>
<h1>📁 {{ _("Folder pair") }}</h1>
<ul class="files">
  <li class="keep">✅ <span class="muted">{{ _("Kept in") }}</span> {{ pair.kept_in }}</li>
  <li class="remove">🗑️ <span class="muted">{{ _("Deleted from") if page.is_clean else _("Will be deleted from") }}</span> {{ pair.removed_from }}</li>
</ul>
<p>{{ ngettext("%(num)s copy", "%(num)s copies", pair.files, num=pair.files | number) }} · {{ pair.size | size }}{% if pair.complete %} · <span class="badge">{{ _("entirely a copy: holds nothing else") }}</span>{% endif %}</p>
{% if pair.samples %}<div class="samples">{% for sample in pair.samples %}<img src="../{{ sample }}" alt="" loading="lazy">{% endfor %}</div>{% endif %}
<h2>{{ _("Every copy") }}</h2>
<p class="muted">{{ _("Each line: the file kept, and the byte-for-byte identical file deleted.") }}</p>
<table>
  <tr><th>{{ _("Kept") }}</th><th>{{ _("Deleted") if page.is_clean else _("Will be deleted") }}</th><th class="num">{{ _("Size") }}</th><th>SHA-256</th></tr>
  {% for copy in page.copies %}
  <tr><td class="keep">{{ copy.kept }}</td><td class="remove">{{ copy.removed }}</td><td class="num">{{ copy.size | size }}</td><td class="muted"><code>{{ copy.digest[:16] }}…</code></td></tr>
  {% endfor %}
</table>
<p class="muted"><a href="../report.html">← {{ _("Back to the report") }}</a></p>
{% endblock %}
