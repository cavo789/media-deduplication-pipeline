msgstr "audit"

msgid "broken files"
msgstr "fichiers cassés"

msgid "can be freed"
msgstr "libérables"

msgid "clean"
msgstr "nettoyage"

msgid "command line"
msgstr "ligne de commande"

msgid "config.toml"
msgstr "config.toml"

msgid "default"
msgstr "défaut"

#, python-format
msgid "duplicate copies in %(groups)s groups"
msgstr "copies en double dans %(groups)s groupes"

#, python-brace-format
msgid "elapsed {time}"
msgstr "écoulé {time}"

msgid "en"
msgstr "fr"

msgid "environment"
msgstr "environnement"

msgid "ffprobe not found: videos are not checked."
msgstr "ffprobe introuvable : les vidéos ne sont pas vérifiées."

msgid "freed"
msgstr "libérés"

#, python-brace-format
msgid "its copy {path} is gone"
msgstr "sa copie {path} a disparu"

msgid "kept"
msgstr "conservée"

msgid "media files scanned"
msgstr "fichiers média analysés"

msgid "media-dedup configuration — created on first run, edit it freely."
msgstr ""
"Configuration de media-dedup — créée au premier lancement, modifiez-la "
"librement."

msgid "media-dedup report"
msgstr "Rapport media-dedup"

msgid "media-dedup reports"
msgstr "Rapports media-dedup"

msgid "protected folder, kept"
msgstr "dossier protégé, conservée"

msgid "run"
msgstr "exécution"

msgid "the file already exists"
msgstr "le fichier existe déjà"

msgid "the file no longer exists"
msgstr "le fichier n'existe plus"

msgid "the files are no longer identical"
msgstr "les fichiers ne sont plus identiques"

#, python-brace-format
msgid "the kept copy {path} no longer exists"
msgstr "la copie conservée {path} n'existe plus"

msgid "the quarantine copy differs from the original"
msgstr "la copie en quarantaine diffère de l'original"

msgid "the restored copy does not match the original"
msgstr "la copie restaurée ne correspond pas à l'original"

msgid "y"
msgstr "o"

msgid "yes"
msgstr "oui"

#, python-brace-format
msgid ""
"{count} file is both in {kept} (kept) and in {removed} (deleted), {size} "
"freed."
msgid_plural ""
"{count} files are both in {kept} (kept) and in {removed} (deleted), "
"{size} freed."
msgstr[0] ""
"{count} fichier est à la fois dans {kept} (gardé) et dans {removed} "
"(supprimé), gain de {size}."
msgstr[1] ""
"{count} fichiers sont à la fois dans {kept} (gardés) et dans {removed} "
"(supprimés), gain de {size}."

#, python-brace-format
msgid ""
"{count} file is present several times in {kept}: one copy is kept ({size}"
" freed)."
msgid_plural ""
"{count} files are present several times in {kept}: one copy of each is "
"kept ({size} freed)."
msgstr[0] ""
"{count} fichier est présent plusieurs fois dans {kept} : un exemplaire "
"est gardé (gain de {size})."
msgstr[1] ""
"{count} fichiers sont présents plusieurs fois dans {kept} : un exemplaire"
" de chacun est gardé (gain de {size})."

#, python-brace-format
msgid "{count} report deleted."
msgid_plural "{count} reports deleted."
msgstr[0] "{count} rapport supprimé."
msgstr[1] "{count} rapports supprimés."

#, python-brace-format
msgid "{name} must be a JSON array, e.g. [\"C:\\\\Photos\"]"
msgstr "{name} doit être un tableau JSON, p. ex. [\"C:\\\\Photos\"]"

#, python-format
msgid "… and %(count)s more groups (largest files are shown first)."
msgstr ""
"… et %(count)s groupes de plus (les plus gros fichiers sont affichés en "
"premier)."

