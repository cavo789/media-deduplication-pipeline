# Safety net only: the devcontainer already redirects every cache to /tmp and keeps the virtual
# environment in the home directory, so none of these should ever appear (zero junk in the repo).
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
.venv/
build/
dist/
*.mo

# Session-local state
.todos/.locks/

# Private Claude Code state — commands, skills, rules, agents, scripts and settings.json are
# public; memory (personal preferences) and plans (conversation working notes) are not.
.claude/memory/
.claude/plans/
.claude/settings.local.json
